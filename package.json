{
  "name": "ai4reverse-web",
  "version": "1.0.0",
  "description": "Traceless malicious JavaScript analysis platform built on quickjs-emscripten and Babel",
  "type": "module",
  "main": "tools/index.js",
  "exports": {
    ".": {
      "types": "./types/ai4reverse.d.ts",
      "import": "./tools/index.js",
      "default": "./tools/index.js"
    },
    "./sandbox": {
      "types": "./types/sandbox.d.ts",
      "import": "./tools/sandbox/index.js",
      "default": "./tools/sandbox/index.js"
    },
    "./instrumentation": {
      "types": "./types/instrumentation.d.ts",
      "import": "./tools/instrumentation/index.js",
      "default": "./tools/instrumentation/index.js"
    },
    "./hook": {
      "types": "./types/hook.d.ts",
      "import": "./tools/hook/index.js",
      "default": "./tools/hook/index.js"
    },
    "./restore": {
      "types": "./types/restore.d.ts",
      "import": "./tools/restore/index.js",
      "default": "./tools/restore/index.js"
    },
    "./analysis": {
      "types": "./types/analysis.d.ts",
      "import": "./tools/analysis/index.js",
      "default": "./tools/analysis/index.js"
    },
    "./jsvmp": {
      "types": "./types/jsvmp.d.ts",
      "import": "./tools/jsvmp/index.js",
      "default": "./tools/jsvmp/index.js"
    },
    "./logging": {
      "types": "./types/logging.d.ts",
      "import": "./tools/logging/index.js",
      "default": "./tools/logging/index.js"
    },
    "./invocation": {
      "types": "./types/invocation.d.ts",
      "import": "./tools/invocation/index.js",
      "default": "./tools/invocation/index.js"
    },
    "./util": {
      "types": "./types/util.d.ts",
      "import": "./tools/util/index.js",
      "default": "./tools/util/index.js"
    },
    "./cli": {
      "types": "./types/cli.d.ts",
      "import": "./tools/cli.js",
      "default": "./tools/cli.js"
    }
  },
  "types": "./types/ai4reverse.d.ts",
  "files": [
    "tools",
    "docs",
    "types",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "ai4reverse": "./tools/cli.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:verbose": "node --test --test-reporter=spec $(ls tests/*.test.js | tr '\\n' ' ')",
    "analyze": "node tools/cli.js analyze",
    "restore": "node tools/cli.js restore",
    "run": "node tools/cli.js run",
    "test:watch": "node --test --watch tests/*.test.js",
    "build:sdk": "node examples/national-sdk/build/build-sdk.mjs --seeds 1001-1003",
    "verify:sdk": "node examples/national-sdk/verify.mjs",
    "demo:sdk": "node examples/national-sdk/demo.mjs"
  },
  "keywords": [
    "malware-analysis",
    "javascript",
    "deobfuscation",
    "sandbox",
    "quickjs",
    "babel",
    "jsvmp"
  ],
  "author": "ai4reverse-web contributors",
  "license": "ISC",
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.7",
    "@babel/template": "^8.0.0",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "quickjs-emscripten": "^0.32.0"
  }
}
